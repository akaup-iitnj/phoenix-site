{
  "name": "phoenix-industrial-labs-site",
  "private": true,
  "version": "1.0.0",
  "description": "phoenixindustriallabs.com: build, tests, and GitHub Pages deploy",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node tools/build.js",
    "serve": "node tools/serve.js dist/site 4173",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:lighthouse": "node tools/lighthouse.js",
    "brand-images": "node tools/brand-images.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.56.0",
    "lighthouse": "^13.4.1",
    "playwright": "1.56.0"
  }
}
